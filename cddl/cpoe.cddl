; Cryptographic Proof of Effort (CPoE) Evidence and Written Authorship Report Schema
; draft-condrey-cpoe-protocol / draft-condrey-cpoe-appraisal
;
; This schema defines the CBOR-encoded data structures for the
; Cryptographic Proof of Effort framework. Evidence Packets are identified by
; CBOR tag 1129336645 (0x43504F45 = "CPoE"), Written Authorship Reports by
; CBOR tag 1129791826 (0x43574152 = "CWAR"), and Compact References by
; CBOR tag 1129336658 (0x43504F52 = "CPoR").
;
; External types (see RFC 9052 for COSE_Sign1)
;
; All map keys use integer encoding per IETF CBOR conventions.
; All temporal and entropy measurements use unsigned integers (uint).
; Timestamps and durations are in milliseconds. Entropy estimates
; are in centibits (1/100th of a bit).

; ============================================================
; CBOR Tag Wrappers
; ============================================================

cpoe-evidence = #6.1129336645(evidence-packet)  ; "CPoE"
cpoe-war      = #6.1129791826(attestation-result) ; "CWAR"
cpoe-ref      = #6.1129336658(compact-ref)       ; "CPoR"

; ============================================================
; Evidence Packet (Protocol)
; ============================================================

evidence-packet = {
    1  => uint,                   ; version (MUST be 1)
    2  => tstr,                   ; profile-uri
    3  => uuid,                   ; packet-id (16 bytes, >=4 non-zero)
    4  => pop-timestamp,          ; created
    5  => document-ref,           ; document
    6  => [3* checkpoint],        ; checkpoints (min 3, max 10000)
    ? 7  => attestation-tier,
    ? 8  => [* tstr],             ; limitations (max 100)
    ? 9  => profile-declaration,
    ? 10 => [+ presence-challenge],  ; (max 100)
    ? 11 => channel-binding,
    ? 12 => bstr .size 32,        ; signing-public-key (Ed25519)
    ? 13 => content-tier,
    ? 14 => hash-value,           ; previous-packet-ref
    ? 15 => uint,                 ; packet-sequence (1-based)
    ? 18 => physical-liveness,
    ? 19 => baseline-verification,
    ? 20 => tstr,                 ; author-did (must start with "did:")
}

checkpoint = {
    1  => uint,                   ; sequence
    2  => uuid,                   ; checkpoint-id (16 bytes)
    3  => pop-timestamp,          ; timestamp
    4  => hash-value,             ; content-hash
    5  => uint,                   ; char-count
    6  => edit-delta,             ; delta
    7  => hash-value,             ; prev-hash
    8  => hash-value,             ; checkpoint-hash
    9  => process-proof,          ; SWF proof
    ? 10 => jitter-binding,
    ? 11 => physical-state,
    ? 12 => bstr .size (32/48/64),  ; entangled-mac
    ? 13 => [+ receipt],            ; (max 100)
    ? 14 => [+ active-probe],      ; (max 100)
    ? 15 => hat-proof,
    ? 16 => beacon-anchor,
    ? 17 => bstr .size 32,        ; verifier-nonce
    ? 18 => bstr .size 8192,      ; lamport-signature
    ? 19 => bstr .size 8,         ; lamport-pubkey-fingerprint
}

document-ref = {
    1 => hash-value,              ; content-hash
    ? 2 => tstr,                  ; filename
    3 => uint,                    ; byte-length
    4 => uint,                    ; char-count
    ? 5 => hash-salt-mode,
    ? 6 => bstr .size (32/48/64), ; salt-commitment
}

; ============================================================
; Sequential Work Function (SWF)
; ============================================================

process-proof = {
    1 => proof-algorithm,
    2 => proof-params,
    3 => bstr,                    ; input (max 64 bytes)
    4 => bstr,                    ; merkle-root (max 64 bytes)
    5 => [+ merkle-proof],        ; sampled-proofs (max 1000)
    6 => uint,                    ; claimed-duration (ms)
}

proof-params = {
    1 => uint,                    ; time-cost
    2 => uint,                    ; memory-cost (KiB)
    3 => uint,                    ; parallelism
    4 => uint,                    ; steps
    ? 5 => uint,                  ; waypoint-interval (Mode 10)
    ? 6 => uint,                  ; waypoint-memory (KiB, Mode 10)
}

merkle-proof = {
    1 => uint,                    ; leaf-index
    2 => [+ bstr .size 32],       ; sibling-path (SHA-256, max depth 64)
    3 => bstr,                    ; leaf-value (max 64 bytes)
}

; ============================================================
; Behavioral Entropy and Physical State
; ============================================================

jitter-binding = {
    1 => [+ uint],                ; intervals (ms, max 100000)
    2 => uint,                    ; entropy-estimate (centibits)
    3 => bstr,                    ; jitter-seal (HMAC, max 64 bytes)
}

edit-delta = {
    1 => uint,                    ; chars-added
    2 => uint,                    ; chars-deleted
    3 => uint,                    ; op-count
    ? 4 => [* edit-position],     ; (max 100000)
    ? 5 => bstr,                  ; edit-graph-hash
    ? 9  => [8*8 uint],           ; cursor-trajectory-histogram
    ? 10 => [8*8 uint],           ; revision-depth-histogram
    ? 11 => [8*8 uint],           ; pause-duration-histogram
}

edit-position = [uint, int]       ; (offset, delta); delta != 0

physical-state = {
    1 => [+ int],                 ; thermal (millidegrees, max 10000)
    2 => int,                     ; entropy-delta
    ? 3 => bstr .size 32,         ; kernel-commitment
    ? 4 => [+ inertial-sample],   ; accelerometer (ENHANCED+)
}

inertial-sample = [
    pop-timestamp,
    int,                          ; x-axis (micro-g)
    int,                          ; y-axis (micro-g)
    int,                          ; z-axis (micro-g)
]

physical-liveness = {
    1 => [+ thermal-sample],      ; thermal-trajectory (max 10000)
    2 => bstr .size 32,           ; entropy-anchor
}

thermal-sample = [pop-timestamp, int]  ; (timestamp, millidegree delta)

; ============================================================
; Hardware-Anchored Time (HAT)
; ============================================================

hat-proof = {
    1 => bstr,                    ; time-before (TPMS_TIME_ATTEST_INFO)
    2 => bstr,                    ; time-after
    3 => bstr,                    ; sig-before (AIK signature)
    4 => bstr,                    ; sig-after
}

; ============================================================
; Beacon-Anchored Binding (Optional)
; ============================================================

beacon-anchor = {
    1 => tstr,                    ; beacon-source (URI)
    2 => uint,                    ; beacon-round
    3 => bstr .size 32,           ; beacon-value
}

; ============================================================
; Behavioral Baseline Verification
; ============================================================

baseline-verification = {
    1 => baseline-digest / null,  ; null during enrollment
    2 => session-behavioral-summary,
    ? 3 => bstr,                  ; digest-signature (COSE_Sign1)
}

baseline-digest = {
    1  => uint,                   ; version (MUST be 1)
    2  => uint,                   ; session-count
    3  => uint,                   ; total-keystrokes
    4  => streaming-stats,        ; iki-stats
    5  => streaming-stats,        ; cv-stats
    6  => streaming-stats,        ; hurst-stats
    7  => [9*9 float32],          ; aggregate-iki-histogram
    8  => streaming-stats,        ; pause-stats
    9  => bstr .size 32,          ; session-merkle-root (MMR)
    10 => confidence-tier,        ; baseline maturity
    11 => pop-timestamp,          ; computed-at
    12 => bstr .size 32,          ; identity-fingerprint
}

session-behavioral-summary = {
    1 => [9*9 float32],           ; iki-histogram
    2 => float32,                 ; iki-cv
    3 => float32,                 ; hurst exponent
    4 => float32,                 ; pause-frequency
    5 => uint,                    ; duration-secs
    6 => uint,                    ; keystroke-count
}

streaming-stats = {
    1 => uint,                    ; count
    2 => float32,                 ; mean
    3 => float32,                 ; m2 (Welford's running variance)
    4 => float32,                 ; min
    5 => float32,                 ; max
}

confidence-tier = &(
    population-reference: 1,
    emerging:             2,
    established:          3,
    mature:               4,
)

; ============================================================
; Presence Challenges and Profiles
; ============================================================

presence-challenge = {
    1 => bstr .size (16..256),    ; challenge-nonce
    2 => bstr,                    ; device-signature (COSE_Sign1)
    3 => pop-timestamp,           ; response-time
}

profile-declaration = {
    1 => tstr,                    ; profile-id
    2 => [+ uint],                ; feature-flags (max 100)
}

binding-type = &(
    tls-exporter: 1,              ; RFC 5705
)

channel-binding = {
    1 => binding-type,
    2 => bstr .size 32,           ; binding-value (TLS EKM)
}

; ============================================================
; Receipts (Composition and Tool Attribution)
; ============================================================

receipt = self-receipt / tool-receipt

self-receipt = {
    1 => tstr,                    ; tool-id
    2 => hash-value,              ; output-commit
    3 => hash-value,              ; evidence-ref
    4 => pop-timestamp,           ; transfer-time
}

tool-receipt = {
    1 => tstr,                    ; tool-id
    2 => hash-value,              ; output-commit
    ? 3 => hash-value,            ; input-ref
    4 => pop-timestamp,           ; issued-at
    5 => bstr,                    ; tool-signature (COSE_Sign1)
    ? 6 => uint,                  ; output-char-count
}

; ============================================================
; Active Probes (Liveness Challenges)
; ============================================================

active-probe = {
    1 => probe-type,
    2 => pop-timestamp,           ; stimulus-time
    3 => pop-timestamp,           ; response-time
    4 => bstr,                    ; stimulus-data
    5 => bstr,                    ; response-data
    ? 6 => uint,                  ; response-latency (ms)
}

probe-type = &(
    galton-board:    1,
    reflex-gate:     2,
    spatial-target:  3,
)

; ============================================================
; Written Authorship Report / WAR (Appraisal)
; CBOR tag 1129791826
; ============================================================

attestation-result = {
    1  => uint,                   ; version (MUST be 1)
    2  => hash-value,             ; evidence-ref
    3  => verdict,                ; appraisal verdict
    4  => attestation-tier,       ; assessed assurance level
    5  => uint,                   ; chain-length
    6  => uint,                   ; chain-duration (seconds)
    ? 7  => entropy-report,
    ? 8  => forgery-cost-estimate,
    ? 9  => [+ absence-claim],    ; (max 100)
    ? 10 => [* tstr],             ; warnings (max 100)
    11 => bstr,                   ; verifier-signature (COSE_Sign1)
    12 => pop-timestamp,          ; created
    ? 13 => forensic-summary,
    ? 14 => confidence-tier,
    ? 15 => effort-attribution,
}

verdict = &(
    authentic:    1,
    inconclusive: 2,
    suspicious:   3,
    invalid:      4,
)

forensic-summary = {
    1 => uint,                    ; flags-triggered
    2 => uint,                    ; flags-evaluated
    3 => uint,                    ; affected-checkpoints
    4 => uint,                    ; total-checkpoints
    ? 5 => [+ forensic-flag],     ; (max 200)
}

forensic-flag = {
    1 => tstr,                    ; mechanism (e.g. "SNR", "CLC")
    2 => bool,                    ; triggered
    3 => uint,                    ; affected-windows
    4 => uint,                    ; total-windows
}

entropy-report = {
    1 => float32,                 ; timing-entropy (bits/sample)
    2 => float32,                 ; revision-entropy (bits)
    3 => float32,                 ; pause-entropy (bits)
    4 => bool,                    ; meets-threshold
}

; ============================================================
; Forgery Cost Bound (Appraisal)
; ============================================================

forgery-cost-estimate = {
    1 => float32,                 ; c-swf
    2 => float32,                 ; c-entropy
    3 => float32,                 ; c-hardware
    4 => float32,                 ; c-total
    5 => cost-unit,
}

cost-unit = &(
    usd:       1,
    cpu-hours: 2,
)

; ============================================================
; Effort Attribution (Appraisal)
; ============================================================

effort-attribution = {
    1 => float32,                 ; human-fraction
    2 => uint,                    ; human-checkpoints
    3 => uint,                    ; receipt-checkpoints
    ? 4 => uint,                  ; tool-attributed-chars
    ? 5 => uint,                  ; total-chars
}

; ============================================================
; Absence Claims (Appraisal)
; ============================================================

absence-claim = {
    1 => absence-type,
    2 => time-window,
    3 => tstr,                    ; claim-id
    ? 4 => any,                   ; threshold
    5 => bool,                    ; assertion
}

absence-type = &(
    computationally-bound:  1,
    monitoring-dependent:   2,
    environmental:          3,
)

time-window = {
    1 => pop-timestamp,           ; start
    2 => pop-timestamp,           ; end
}

; ============================================================
; Enumerations
; ============================================================

attestation-tier = &(
    software-only:      1,        ; T1 / AAL1
    attested-software:  2,        ; T2 / AAL2
    hardware-bound:     3,        ; T3 / AAL3
    hardware-hardened:  4,        ; T4 / LoA4
)

content-tier = &(
    core:     1,
    enhanced: 2,
    maximum:  3,
)

proof-algorithm = &(
    swf-sha256:             10,
    swf-argon2id:           20,
    swf-argon2id-entangled: 21,
)

hash-salt-mode = &(
    unsalted:       0,
    author-salted:  1,
)

hash-algorithm = &(
    sha-256: 1,
    sha-384: 2,
    sha-512: 3,
)

feature-id = &(
    swf-argon2id-sha256:    1,    ; MTI for all tiers
    content-binding:        2,
    checkpoint-chain:       4,
    behavioral-entropy:     50,
    edit-graph-hash:        51,
    edit-graph-histograms:  52,
    assistive-mode:         60,
    hardware-attestation:   105,
)

; ============================================================
; Base Types
; ============================================================

uuid = bstr .size 16
pop-timestamp = uint              ; epoch milliseconds
hash-value = {
    1 => hash-algorithm,
    2 => bstr,                    ; digest (length per algorithm)
}
compact-ref = {
    1 => hash-algorithm,
    2 => bstr .size (8..32),      ; truncated-digest
    3 => uint,                    ; prefix-length
}
